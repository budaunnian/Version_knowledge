;------------------------------------------------------------------------------
; Videocapture sections
;------------------------------------------------------------------------------

[UVC_Device.NTamd64]
Include=    ks.inf, kscaptur.inf
Needs=      KS.Registration,KSCAPTUR.Registration.NT
AddReg=     UVC_AddReg
CopyFiles=  DRV_CopyDrivers

[UVC_AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,%DriverFilename%
HKR,,PageOutWhenUnopened,3,01
HKR,,DontSuspendIfStreamsAreRunning,3,01
HKR,,OkToHibernate,3,01

;------------------------------------------------------------------------------
; Interface sections
;------------------------------------------------------------------------------

[UVC_Device.NTamd64.Interfaces]
AddInterface=%KSCATEGORY_CAPTURE%,"GLOBAL",UVC_VideoCapture,

[UVC_VideoCapture]
AddReg=UVC_VideoCapture_AddReg

[UVC_VideoCapture_AddReg]
HKR,,CLSID,,{17CCA71B-ECD7-11D0-B908-00A0C9223196}
HKR,,FriendlyName,,%CaptureFilterName%

;------------------------------------------------------------------------------
; Service sections
;------------------------------------------------------------------------------

[UVC_Device.NTamd64.Services]
AddService=UVC,0x00000002,UVC_ServiceInstall

[UVC_ServiceInstall]
ServiceType   = %SERVICE_KERNEL_DRIVER%
StartType     = %SERVICE_DEMAND_START%
ErrorControl  = %SERVICE_ERROR_NORMAL%
ServiceBinary = %12%\%DriverFilename%

;------------------------------------------------------------------------------
; CoInstaller sections
;------------------------------------------------------------------------------
[UVC_Device.NTamd64.CoInstallers]
AddReg=CoInstaller_AddReg
CopyFiles=CoInstaller_CopyFiles

; we set this to "ignore when already there"
[CoInstaller_CopyFiles]
%CoInstallerFilename%,,,0x10

[CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000,"%CoInstallerFilename%,DRVCoInstaller"

;------------------------------------------------------------------------------
; String sections
;------------------------------------------------------------------------------


[Strings]
Provider				= "The Imaging Source Europe GmbH"
ManufacturerMfg			= "The Imaging Source Europe GmbH"
DeviceDescString		= "TIS UVC Device"
CaptureFilterName   	= "TIS UVC Device"

Disc1					= "Installation Directory"

DriverFilename 			= "usbcam_298.sys"

CoInstallerFilename 		= "drvcoinst2.dll"

KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"

RunOnce = "SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce"

SERVICE_KERNEL_DRIVER=1
SERVICE_AUTO_START=2
SERVICE_ERROR_NORMAL=1
SERVICE_DEMAND_START=3
