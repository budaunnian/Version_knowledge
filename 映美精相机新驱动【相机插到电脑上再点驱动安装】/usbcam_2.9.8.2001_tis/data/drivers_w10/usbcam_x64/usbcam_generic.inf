;--------------------------------------------------------------------------------------;
[Version]
signature="$CHICAGO$"
Class=Image
ClassGUID={6bdd1fc6-810f-11d0-bec7-08002be2092f}
Provider=%Provider%
DriverVer = 08/19/2019,2.9.8.2001
CatalogFile=usbcam_generic.cat

[ControlFlags]
ExcludeFromSelect=*

[Manufacturer]
%ManufacturerMfg%=OEM,ntamd64

;------------------------------------------------------------------------------
; File sections
;------------------------------------------------------------------------------

[SourceDisksNames]
1=%Disc1%

[SourceDisksFiles.amd64]
usbcam_298.sys=1
drvcoinst2.dll=1

[DestinationDirs]
DRV_CopyDrivers=12
CoInstaller_CopyFiles=11

[DRV_CopyDrivers]
%DriverFilename%
 
