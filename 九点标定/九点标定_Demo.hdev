<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="23.05.0.0">
<procedure name="main">
<interface/>
<body>
<c as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,1]" as_ord="1">* Image Acquisition 01: Code generated by Image Acquisition 01</c>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[1,1]" as_ord="2">open_framegrabber ('DirectShow', 1, 1, 0, 0, 0, 0, 'default', 8, 'rgb', -1, 'false', 'default', '[0] DMx 22BUC03', 0, -1, AcqHandle)</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,1]" as_ord="1">grab_image_start (AcqHandle, -1)</l>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,3]" as_ord="1">grab_image_async (Image, AcqHandle, -1)</l>
<c as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[2,4]" as_ord="1">* Image Acquisition 01: Do something</c>
<l as_id="image_acquisition" as_name="Image Acquisition 01" as_grp="[4,1]" as_ord="1">close_framegrabber (AcqHandle)</l>
<c></c>
<c></c>
<l>threshold (Image, Regions, 15, 65)</l>
<l>connection (Regions, ConnectedRegions)</l>
<l>select_shape (ConnectedRegions, SelectedRegions, 'circularity', 'and', 0.36506, 1)</l>
<c></c>
<l>NineRow :=[]</l>
<l>NineCol :=[]</l>
<c></c>
<c></c>
<c></c>
<l>count_obj (SelectedRegions, Number)</l>
<l>sort_region (SelectedRegions, SortedRegions, 'character', 'true', 'row')</l>
<l>area_center (SortedRegions, Area, Row, Column)</l>
<c></c>
<l>for i := 0 to 4 by 2</l>
<c>    </c>
<c>    * 内层循环控制列：0, 2, 4 (间隔一个，取前3列，正好 3x3=9个点)</c>
<c>    * 如果你想取 4列(0,2,4,6)，把 4 改成 6 即可</c>
<l>    for j := 0 to 4 by 2</l>
<c>        </c>
<c>        * 计算在一维元组中的真实索引</c>
<c>        * i=0时，取 0, 2, 4</c>
<c>        * i=2时，取 14, 16, 18</c>
<c>        * i=4时，取 28, 30, 32</c>
<l>        index := i * 7 + j</l>
<c>        </c>
<c>        * 追加坐标到新元组中</c>
<l>        NineRow := [NineRow, Row[index]]</l>
<l>        NineCol := [NineCol, Column[index]]</l>
<c>        </c>
<l>    endfor</l>
<l>endfor</l>
<c></c>
<l>MachineX := [123.779, 132.711, 140.941, 123.616, 133.375, 140.174, 123.858, 132.338, 140.324]</l>
<c></c>
<l>MachineY := [44.574, 44.574, 44.574, 52.147, 52.147, 52.147, 59.993, 59.993, 59.993]</l>
<c></c>
<l>vector_to_hom_mat2d (NineRow,NineCol, MachineX, MachineY, HomMat2D)</l>
<l>open_file ('C:/Users/20765/Desktop/九点标定', 'output_binary', FileHandle)</l>
<c>*将仿射变换举证进行序列</c>
<l>serialize_hom_mat2d (HomMat2D, SerializedItemHandle)</l>
<c>*写入文件</c>
<l>fwrite_serialized_item (FileHandle, SerializedItemHandle)</l>
<c>*关闭文件</c>
<l>close_file (FileHandle)</l>
<c></c>
<c></c>
<l>stop()</l>
<c>*反序列化 重新加载这个矩阵</c>
<l>open_file ('C:/Users/20765/Desktop/九点标定', 'input_binary', FileHandle1)</l>
<l>fread_serialized_item (FileHandle1, SerializedItemHandle2)</l>
<l>deserialize_hom_mat2d (SerializedItemHandle2, HomMat2D1)</l>
<l>close_file (FileHandle1)</l>
<l>dev_get_window (WindowHandle)</l>
<l>dev_set_draw ('margin')</l>
<c>*测试</c>
<l>    draw_circle(WindowHandle, Row, Column, Radius)</l>
<l>    gen_circle(Circle, Row, Column, Radius)</l>
<l>    reduce_domain(Image, Circle, ImageReduced)</l>
<l>    threshold(ImageReduced, Region, 0, 100)</l>
<l>    closing_circle(Region, RegionClosing, 3.5)</l>
<l>    gen_contour_region_xld(RegionClosing, Contours, 'border')</l>
<l>    fit_circle_contour_xld(Contours, 'algebraic', -1, 0, 0, 3, 2, Row1, Column1, Radius1, StartPhi, EndPhi, PointOrder)</l>
<l>    area_center(RegionClosing, Area, Row2, Column2)</l>
<l>    gen_cross_contour_xld (Cross1, Row2, Column2, 16, StartPhi)</l>
<c>    *核心算子，通过上面建立的矩阵，把像素坐标就可以转换成机械坐标了</c>
<l>affine_trans_point_2d(HomMat2D1, Column2, Row2, Qx, Qy)</l>
<c>*这两个算子是设置字符的位置，并显示字符</c>
<l>set_tposition(WindowHandle,  Row2, Column2)</l>
<l>write_string(WindowHandle,Qx$'.3'+' '+Qy$'.3')</l>
<c></c>
<l>stop()</l>
<c></c>
<l>CirCol:=[]</l>
<l>CirRow:=[]</l>
<l>X:=[]</l>
<l>Y:=[]</l>
<l> dev_display(Image)</l>
<l>for Index := 0 to 1 by 1</l>
<l>    draw_circle(WindowHandle, Row, Column, Radius)</l>
<l>    gen_circle(Circle, Row, Column, Radius)</l>
<l>    reduce_domain(Image, Circle, ImageReduced)</l>
<l>    threshold(ImageReduced, Region, 0, 100)</l>
<l>    closing_circle(Region, RegionClosing, 3.5)</l>
<l>    gen_contour_region_xld(RegionClosing, Contours, 'border')</l>
<l>    fit_circle_contour_xld(Contours, 'algebraic', -1, 0, 0, 3, 2, Row1, Column1, Radius1, StartPhi, EndPhi, PointOrder)</l>
<l>    area_center(RegionClosing, Area, Row2, Column2)</l>
<l>    CirRow:=[CirRow,Row2]</l>
<l>    CirCol:=[CirCol,Column2]</l>
<l>    affine_trans_point_2d(HomMat2D, Column2, Row2, Qx, Qy)</l>
<c></c>
<l>    X:=[X,Qx]</l>
<l>    Y:=[Y,Qy]</l>
<l>endfor</l>
<l>dev_set_color('blue')</l>
<l>gen_region_line(RegionLines, CirRow[0],CirCol[0],CirRow[1], CirCol[1])</l>
<c>*开始计算两个圆心之间的距离 用点到点的距离算子来计算</c>
<l>distance_pp(Y[0], X[0], Y[1], X[1], Distance)</l>
<l>dev_set_color('red')</l>
<l>set_tposition(WindowHandle,  CirRow[0]+( CirRow[1]- CirRow[0])/2, CirCol[0]+(CirCol[1]-CirCol[0])/2)</l>
<l>write_string(WindowHandle, Distance$'.3')</l>
<l>gen_region_line (RegionLines, CirRow[0],CirCol[0],CirRow[1], CirCol[1])</l>
<l>dev_display (RegionLines)</l>
<c>*set_tposition设置文本光标在输出窗口中的位置。参考位置是大写字母的左上角。</c>
<c>*在图像坐标系中测量位置。文本光标的位置可以被标记，例如，通过下划线。此窗口中的下一个文本输出从光标位置开始。</c>
<c>*用于编写以下文本字符串的基线的左端（不考虑降级）位于此位置。</c>
<c>*通过文本（write_string、read_string）的输出或输入，或通过（set_t.、new_line）的显式位置改变来改变位置。</c>
<c>*为了停止光标的显示，可以使用参数为“不可见”的运算符set_tshape。</c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
